# ==============================================================================
# Mako notification daemon — config untuk Sway (port dari dunstrc i3)
# Tema: Arc-Dark (palet sama dengan waybar & polybar)
# ==============================================================================

# Font & format teks (menyamakan dengan dunst/i3)
font=Ubuntu 9
markup=1
format=<b>%s</b>\n%b

# Ukuran & posisi: pojok kanan atas, offset 60px dari atas, 30px dari kanan
# (dunst: geometry = "350x5-30+60")
width=350
anchor=top-right
margin=50,20
padding=12

# Border Arc-Dark (biru utama)
border-size=2
border-radius=4

# Warna dasar Arc-Dark
background-color=#2f343f
text-color=#f3f4f5
border-color=#5294e2

# Perilaku
default-timeout=5000
max-visible=5
max-history=10
icons=1
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/hicolor
layer=overlay

# Aksi tombol mouse (sama seperti dunst)
on-button-left=dismiss
on-button-middle=invoke-default-action
on-button-right=dismiss-all

# ==============================================================================
# URGENSI (palet Arc-Dark)
# ==============================================================================

[urgency=low]
default-timeout=2000
border-color=#4080d0

[urgency=normal]
default-timeout=5000
border-color=#5294e2

[urgency=critical]
default-timeout=0
border-color=#cc575d
