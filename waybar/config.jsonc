{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "sway/workspaces",
    "sway/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/network-speed",
    "tray",
    "pulseaudio",
    "backlight",
    "memory",
    "cpu",
    "custom/bluetooth",
    "custom/network",
    "battery"
  ],
  "sway/workspaces": {
    "all-outputs": true,
    "format": "{name}",
    "on-click": "activate",
    "on-scroll-up": "swaymsg workspace next",
    "on-scroll-down": "swaymsg workspace prev"
  },
  "sway/window": {
    "max-length": 50,
    "format": "{title}"
  },
  "clock": {
    "format": "{:%a, %d %b %Y - %H.%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
    "interval": 30
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "{icon}  {volume}%",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ],
      "muted": ""
    },
    "on-click": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}  {percent}%",
    "format-icons": [
      ""
    ],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "memory": {
    "format": "{icon}  {used:0.1f}GiB",
    "format-icons": [
      ""
    ],
    "interval": 5
  },
  "cpu": {
    "format": "{icon}  {usage}%",
    "format-icons": [
      ""
    ],
    "interval": 5
  },
  "custom/network": {
    "exec": "~/.config/waybar/scripts/network.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/network-menu.sh",
    "on-click-right": "nm-connection-editor"
  },
  "custom/bluetooth": {
    "exec": "~/.config/waybar/scripts/bluetooth.sh",
    "interval": 5,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/bluetooth-toggle.sh",
    "on-click-right": "blueman-manager",
    "tooltip": true
  },
  "custom/network-speed": {
    "exec": "python3 ~/.config/waybar/scripts/network-speed.py",
    "return-type": "json"
  },
  "battery": {
    "bat": "BAT0",
    "format": "{icon}  {capacity}%",
    "format-charging": "󱐋  {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  }
}
