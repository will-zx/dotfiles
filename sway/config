# ==============================================================================
# 1. CORE CONFIGURATION & VARIABLES (Pengaturan Dasar & Variabel)
# ==============================================================================
set $mod Mod4
#set $mod Mod1
font pango:SF Pro Display 10
floating_modifier $mod

# Cursor
seat * xcursor_theme macOS-White 24
exec dbus-update-activation-environment --systemd XCURSOR_THEME XCURSOR_SIZE
exec_always systemctl --user import-environment XCURSOR_THEME XCURSOR_SIZE

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Define Color Variables
set $bg-color               #5294E2
set $text-color             #002B36
set $border-color           #404552
set $inactive-bg-color      #404552
set $inactive-text-color    #FFFFFF
set $urgent-bg-color        #EAFF00
set $urgent-text-color      #000000
set $indicator              #5294E2

# ==============================================================================
# 2. AUTOSTART APPLICATIONS (Aplikasi yang Berjalan Otomatis)
# ==============================================================================
# gnome polkit 
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Background Wallpaper (native sway, menggantikan feh)
#output * bg $HOME/Pictures/wp/wp8.png fill
output * bg $HOME/Pictures/wallpaper/Joey-Jordison.jpg fill

# blueman-applet (dibutuhkan blueman-manager) tanpa ikon tray
exec --no-startup-id ~/.config/sway/scripts/blueman-applet-headless.sh

# nm-applet (tidak dipakai; network via waybar module)
#exec --no-startup-id nm-applet

# Enable Tap to Click & Natural Scrolling (libinput native)
input type:touchpad {
    tap enabled
    natural_scroll enabled
    accel_profile adaptive
}

# XDG Desktop Portal (frontend + backend gtk) — wajib jalan sebelum aplikasi
# GTK4 4.22 tidak punya fallback GSettings; warna gelap libadwaita hanya
# dibaca lewat interface org.freedesktop.portal.Settings.
exec --no-startup-id sh -c 'pgrep -f "^/usr/lib/xdg-desktop-portal$" >/dev/null 2>&1 || /usr/lib/xdg-desktop-portal'
exec --no-startup-id sh -c 'pgrep -f "^/usr/lib/xdg-desktop-portal-gtk$" >/dev/null 2>&1 || /usr/lib/xdg-desktop-portal-gtk'

# Waybar (pengganti polybar) — guard anti-duplikat
#exec --no-startup-id sh -c 'pgrep -x waybar >/dev/null 2>&1 || LC_TIME=id_ID.UTF-8 waybar'
exec_always --no-startup-id sh -c 'pgrep -x waybar >/dev/null 2>&1 || LC_TIME=id_ID.UTF-8 waybar'


# Mako notification daemon (pengganti dunst) — guard anti-duplikat
exec --no-startup-id sh -c 'pgrep -x mako >/dev/null 2>&1 || mako'

# Audio (PipeWire) — guard: hanya start bila belum berjalan
exec --no-startup-id sh -c 'pgrep -x pipewire >/dev/null 2>&1 || pipewire'
exec --no-startup-id sh -c 'pgrep -x wireplumber >/dev/null 2>&1 || wireplumber'
exec --no-startup-id sh -c 'pgrep -x pipewire-pulse >/dev/null 2>&1 || pipewire-pulse'

# Idle & screen lock (swayidle + swaylock) — matikan layar setelah 11 menit idle
exec_always --no-startup-id sh -c 'pgrep -x swayidle >/dev/null 2>&1 || swayidle -w timeout 600 "swaylock -f" timeout 660 "swaymsg output * dpms off" resume "swaymsg output * dpms on"'


# cliphist: merekam semua salinan ke history via wl-paste --watch
exec_always --no-startup-id wl-paste --watch cliphist store

# ==============================================================================
# 3. WINDOW LOOKS & BEHAVIOR (Estetika & Tampilan Jendela)
# ==============================================================================
# gaps inner/outer
gaps inner 5
gaps outer 5

# Window Title Alignment
# Default is left
# Syntax: title_align left|center|right
title_align center

# For Adding Space and [] Character on Window Title
for_window [class="^.*"] title_format " > %title"
for_window [app_id="^.*"] title_format " > %title"

# Window Container Border Settings
# syntax: default_border normal|none|pixel
default_border normal 0

# Syntax: default_floating_border normal|none|pixel
default_floating_border normal 0

# Window Colors
# Opetion Name           # Border            # Background        # Text                # Indicator
client.focused           $bg-color           $bg-color           $text-color           $indicator
client.unfocused         $inactive-bg-color  $inactive-bg-color  $inactive-text-color  $indicator
client.focused_inactive  $inactive-bg-color  $inactive-bg-color  $inactive-text-color  $indicator
client.urgent            $urgent-bg-color    $urgent-bg-color    $urgent-text-color    $indicator

# Enable Floating Mode for Specific Programs
for_window [class="VirtualBox" instance="VirtualBox" title="New Virtual Machine"] floating enable
for_window [class="steam" instance="steamwebhelper"] floating enable, move position center
for_window [class="ibus"] floating enable

# Aturan untuk aplikasi Wayland-native (class tidak cocok, pakai app_id)
for_window [app_id="blueman-manager" title="Bluetooth Devices"] floating enable, resize set 800 600
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, resize set 800 600
for_window [app_id="nm-connection-editor"] floating enable, resize set 800 600
for_window [app_id="nvidia-settings"] floating enable, resize set 800 600
for_window [app_id="io.github.nozwock.Packet" title="Packet"] floating enable
for_window [app_id="^(W|w)aydroid"] floating enable, resize set width 33 ppt height 100 ppt, move position center
for_window [app_id="thunar" title="Confirm to replace files"] floating enable
for_window [app_id="thunar" title="File Operation Progress"] floating enable
for_window [app_id="blueman-manager" title="blueman"] floating enable
for_window [app_id="Zotero" title="Software Update"] floating enable
for_window [app_id="Zotero" title="Zotero Settings"] floating enable
for_window [app_id="simplescreenrecorder"] floating enable
for_window [app_id="org.gnome.Calculator"] floating enable
for_window [app_id="kitty" title="^.*"] floating disable
for_window [app_id="lxappearance"] floating enable
for_window [app_id="arandr"] floating enable
for_window [app_id="qt5ct"] floating enable
for_window [app_id="qt6ct"] floating enable

# ==============================================================================
# 4. HARDWARE CONTROLS (Media Keys / Kontrol Perangkat Keras)
# ==============================================================================
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Kontrol Brightness
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# ==============================================================================
# 4b. DISPLAY MANAGEMENT (Mirror / Extend / Proyektor)
# ==============================================================================
# Toggle display: laptop only <-> mirror external
bindsym $mod+Alt+d exec --no-startup-id ~/.config/sway/scripts/display-toggle.sh

# Display mode presets (saat projector terhubung)
bindsym $mod+F1 exec --no-startup-id ~/.config/sway/scripts/display-switcher.sh mirror          # Mirror ke proyektor
bindsym $mod+F2 exec --no-startup-id ~/.config/sway/scripts/display-switcher.sh extend-right    # Extend ke kanan
bindsym $mod+F3 exec --no-startup-id ~/.config/sway/scripts/display-switcher.sh extend-left     # Extend ke kiri
bindsym $mod+F4 exec --no-startup-id ~/.config/sway/scripts/display-switcher.sh external-only   # Proyektor only
bindsym $mod+F5 exec --no-startup-id ~/.config/sway/scripts/display-switcher.sh internal-only   # Laptop only

# Toggle display dengan tombol Display (F7)
bindsym XF86Display exec --no-startup-id ~/.config/sway/scripts/display-toggle.sh

# ==============================================================================
# 5. GENERAL KEYBINDINGS (Pintasan Aplikasi & Sistem)
# ==============================================================================
# Open the Blank Space (tidak didukung sway)
#bindsym $mod+o open

# reload the configuration file
bindsym $mod+Shift+c reload

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart

# exit sway
bindsym $mod+Shift+e exec sway-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway?' -B 'Yes, exit sway' 'swaymsg exit'

# start a terminal
bindsym $mod+Return exec kitty

# start rofi (a program launcher)
bindcode $mod+40 exec "rofi -modi drun,run -show drun -show-icons -icon-theme Papirus-Dark"
#bindcode $mod+40 exec "rofi -modi drun,run -show drun -show-icons -icon-theme Arc"

# pavucontrol
bindsym $mod+Shift+v exec --no-startup-id pavucontrol

# Clipboard history (cliphist + rofi) — pilih entri, Enter untuk paste
bindsym $mod+Control+v exec --no-startup-id sh -c 'cliphist list | rofi -dmenu -p "Clipboard: " | cliphist decode | wl-copy'

# Screenshot native Wayland (pengganti xfce4-screenshooter X11) — hasil ke clipboard
bindsym Print exec --no-startup-id sh -c 'grim - | wl-copy'
bindsym $mod+Shift+Print exec --no-startup-id sh -c 'grim -g "$(slurp)" - | wl-copy'

# gnome-calculator
bindsym XF86Calculator exec --no-startup-id gnome-calculator

# arandr
bindsym $mod+Shift+d exec --no-startup-id arandr

# Shutdown laptop
bindsym $mod+Shift+x exec --no-startup-id ~/.config/sway/scripts/power-menu.sh

# Kunci layar (swaylock)
bindsym $mod+Escape exec --no-startup-id swaylock -f

# ==============================================================================
# 6. WINDOW MANAGEMENT & NAVIGATION (Navigasi & Tata Letak Jendela)
# ==============================================================================
# kill focused window
bindsym $mod+Shift+q kill

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# ==============================================================================
# 7. WORKSPACE MANAGEMENT (Pengaturan Workspace)
# ==============================================================================
# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ==============================================================================
# 8. MODES (Mode Pengubah Ukuran Jendela)
# ==============================================================================
# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

